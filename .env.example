# Copia este archivo a .env.local y rellena con los datos de tu proyecto
# Supabase (Project Settings -> API). Ver DEPLOYMENT.md para el detalle.

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Secreta: nunca se expone al navegador (ver SECURITY.md). Necesaria para
# npm run seed y para el servidor MCP (mcp-server/).
SUPABASE_SERVICE_ROLE_KEY=

# http://localhost:3000 en desarrollo; tu dominio real en produccion.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
